# Copy to `.env.local` for local development. Never commit real values.
# All variables are public (NEXT_PUBLIC_*): they end up in the browser code,
# so only put public URLs and public keys here, never secrets.
# They are read at build time: after changing one in Netlify, redeploy.

# Public URL of the site (canonical links, hreflang, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Live mode, for a demo by appointment only (D-020): base URL of one project's API.
# One variable per project: NEXT_PUBLIC_DEMO_API_01 … NEXT_PUBLIC_DEMO_API_09.
# Left empty, the player only replays recorded sessions (the normal public site).
# Do not set these on the public Netlify site.
# NEXT_PUBLIC_DEMO_API_05=http://localhost:8000
